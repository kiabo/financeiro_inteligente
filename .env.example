# GEMINI_API_KEY: Server-side API key for AI CFO module (Módulo 5).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# Provedor de IA do CFO Virtual (Módulo 5): "gemini" (nativo) ou "openai" (compatível OpenAI-style)
AI_PROVIDER=gemini
AI_MODEL=gemini-4-hydrogen

# Opcional: Compatibilidade OpenAI-style (usado apenas no servidor quando AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SUPABASE (Módulo 1 — Auth Invite-Only + MFA + PostgreSQL RLS)
# Obtenha no painel Supabase em "Connect" ou "Project Settings -> API Keys"
# Nunca coloque SUPABASE_SECRET_KEY / SERVICE_ROLE_KEY no frontend!
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternativa compatível (chave legada anon):
VITE_SUPABASE_ANON_KEY=
# Opcional (server-side apenas, para persistência direta de rascunhos MCP):
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# MÓDULO 6 — Integrações, Webhooks, Google, Alertas e Backup (somente servidor)
# ============================================================================
# URL pública do app (usada nas URLs de webhook e no redirect OAuth do Google).
# Em desenvolvimento local os gateways não alcançam localhost: use um túnel (cloudflared/ngrok).
# APP_URL=https://financeiro.seudominio.com.br
# Atrás de proxy reverso (Railway/Render/Fly/Nginx), para gerar URLs https:
TRUST_PROXY=false

# Chave mestra que cifra (AES-256-GCM) os segredos de webhook e o refresh token do Google no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: trocar esta chave invalida as credenciais já salvas (será preciso recadastrá-las).
CREDENTIALS_ENCRYPTION_KEY=

# Frase-senha do backup criptografado (mínimo 24 caracteres). GUARDE FORA DO SERVIDOR:
# sem ela nenhum backup pode ser restaurado.
BACKUP_ENCRYPTION_KEY=

# Google OAuth (Drive + Calendar) — Google Cloud Console → APIs & Services → Credentials
# Tipo "Web application"; Authorized redirect URI = <APP_URL>/api/google/oauth/callback
# Ative as APIs "Google Drive API" e "Google Calendar API".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional (padrão: <APP_URL>/api/google/oauth/callback)
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# E-mail via Resend (https://resend.com) — domínio remetente verificado
RESEND_API_KEY=
NOTIFY_EMAIL_FROM="Vértice Alertas <alertas@seudominio.com.br>"

# WhatsApp: "evolution" (Evolution API) ou "cloud_api" (WhatsApp Cloud API da Meta)
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Rotinas diárias (agenda, alertas, backup, liquidação de webhooks D+N):
# Opção A — cron externo: POST <APP_URL>/api/cron/daily com "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Opção B — agendador interno do servidor Node (para hospedagem sempre ligada / uso local)
ENABLE_INTERNAL_SCHEDULER=false
DAILY_JOBS_HOUR=7
